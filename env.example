# ============================================
# 管理画面システム 環境変数設定
# このファイルをコピーして .env にリネームし
# 実際の値を入力してください（cp env.example .env）
#
# 値は絶対にコミットしないこと。詳細は docs/02_環境変数リファレンス.md
# ============================================

# ---- データベース（MongoDB） ----

# 【必須】管理画面自身のデータ（Admin/AuditLog/Notification等）用。専用クラスタ推奨
ADMIN_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/app-admin

# 【推奨】care（アプリ本体）が書き込んでいる users コレクションへの読み取り専用接続。
# 顧客一覧・顧客分析・オンライン判定など「顧客管理」系の機能はこれが無いと動作しない。
# 未設定でもビルド・起動は通るが、connectAppDB() が null を返し該当機能が空表示になる
APP_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<care-db>

# ---- 認証（NextAuth v5） ----

# 【必須】セッション暗号化キー。生成コマンド: openssl rand -base64 32
AUTH_SECRET=<ここに32文字以上のランダム文字列>

# 【本番は必須】ログイン成功後のリダイレクト先。basePath "/admin" を含めること
# （例: 本番 https://hapiken.jp/admin、ローカル開発は未設定でも "/admin" にフォールバックする）
# 含め忘れると NextAuth が basePath なしの誤ったURLへリダイレクトする
AUTH_URL=http://localhost:3000/admin

# 注意: AUTH_TRUST_HOST はここで設定する必要はない。
# next.config.ts と auth.ts の両方で "true" が強制上書きされるため、
# .env に書いても無視される（コードの仕様。詳細は docs/01_アーキテクチャ.md）

# ---- プッシュ通知（Firebase Admin SDK V1 / FCM） ----

# 【任意・ただし実質必須】Firebaseサービスアカウント鍵をJSONごとBase64エンコードした文字列
# 取得手順: Firebaseコンソール > プロジェクトの設定 > サービスアカウント > 新しい秘密鍵を生成
#   → 生成したJSONファイルを `base64 -i key.json` などでエンコードして貼り付け
# 【重要】未設定でもエラーにならず、通知は「送信成功」としてDBに記録されるが実際には
# 端末に届かない（mock送信フォールバック）。気づきにくい落とし穴なので必ず設定すること
FIREBASE_SERVICE_ACCOUNT_KEY=<Base64エンコードされたサービスアカウントJSON>

# ---- 通知スケジュール配信（Cloud Scheduler） ----
# 単発予約・繰り返し配信の通知で使用。上記 FIREBASE_SERVICE_ACCOUNT_KEY と同じ
# サービスアカウントを流用するため、GCP側でそのサービスアカウントに
# roles/cloudscheduler.admin を追加付与しておくこと

# 【単発予約・繰り返し配信を使うなら必須】Cloud SchedulerのJobを作成するリージョン
GCP_SCHEDULER_LOCATION=asia-northeast1

# 【単発予約・繰り返し配信を使うなら必須】Cloud Schedulerが配信処理エンドポイントを
# 呼び出す際のベースURL。本番は AUTH_URL と同じ値でよい（例: https://hapiken.jp/admin）
NOTIFICATION_DISPATCH_BASE_URL=http://localhost:3000/admin

# 【単発予約・繰り返し配信を使うなら必須】Cloud Schedulerからの呼び出しを認証する
# 共有シークレット。生成コマンド: openssl rand -base64 32
NOTIFICATION_DISPATCH_SECRET=<ここに32文字以上のランダム文字列>

# ---- 画像アップロード（キャンペーン画像 / Firebase Storage） ----
# 上記 FIREBASE_SERVICE_ACCOUNT_KEY と同じサービスアカウントを使用する

# 【任意・ただし画像アップロード機能に実質必須】Firebase Storageのバケット名
# 取得手順: Firebaseコンソール > Storage > 利用開始（リージョン: asia-northeast1）
#   → 有効化後に表示されるバケット名をそのまま貼り付け（2024年10月以降に作成された
#   プロジェクトは `<project-id>.firebasestorage.app` 形式、それ以前は
#   `<project-id>.appspot.com` 形式のことがあるので、コンソール表示値をそのまま使うこと）
# 【重要】未設定だとキャンペーン画像アップロードがエラーになる
FIREBASE_STORAGE_BUCKET=gs://<project-id>.firebasestorage.app

# ---- メール送信（問い合わせ返信・メルマガ配信） ----
# 全て未設定でもビルド・起動は通るが、メール送信系機能が動作しない

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
# "true" の場合SMTPS(465番想定)。SendGrid等の587番STARTTLSは "false" のままでよい
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=<SMTPプロバイダのAPIキー/パスワード>
SMTP_FROM=noreply@yourdomain.com

# ---- 広告媒体レポート連携 ----
# 媒体ごとに、下の変数が全部そろったものだけを同期する（1つでも欠けていれば「未接続」として
# 飛ばし、/ads 画面の該当指標は値の代わりに「未接続: 媒体名」を出す）。
# 媒体の一覧と必須変数の定義は lib/ad-sources/registry.ts

# 定期同期（cron）が POST /api/ads/sync を呼ぶときの Bearer トークン。未設定なら cron からの
# 呼び出しは全部拒否される（画面の「今すぐ同期」はログイン中の書き込みロールで動くので不要）。
# 生成例: openssl rand -hex 32
AD_SYNC_SECRET=

# Tenjin（広告費・インストール数）
TENJIN_API_KEY=

# Google AdMob（広告収益）。OAuth クライアントとリフレッシュトークン、パブリッシャーID（pub-...）
ADMOB_CLIENT_ID=
ADMOB_CLIENT_SECRET=
ADMOB_REFRESH_TOKEN=
ADMOB_PUBLISHER_ID=

# AdGeneration（広告収益）。API キーは無く、管理画面のユーザーのメールアドレスとパスワードで取る（取り込み専用のユーザーを作る）
ADGENERATION_EMAIL=
ADGENERATION_PASSWORD=

# SmaAD（広告収益）
SMAAD_API_KEY=

# App Store Connect（アプリ売上）。PRIVATE_KEY は API キー（.p8）の中身
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_VENDOR_NUMBER=

# Google Play Console（アプリ売上）。レポートのバケットを読めるサービスアカウントのJSON。
# FIREBASE_SERVICE_ACCOUNT_KEY とは別物・別用途なので混同しないこと
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# 例: pubsite_prod_rev_01234567890987654321
GOOGLE_PLAY_REPORTS_BUCKET=

# ---- その他 ----

# 本番デプロイ時は "production" を設定（PM2のecosystem設定側で指定されることが多い）
NODE_ENV=development
